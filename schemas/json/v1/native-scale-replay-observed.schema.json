{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeScaleReplayObserved",
  "description": "Recorded numerical replay inputs/output, not objective execution or acceptance.",
  "type": "object",
  "properties": {
    "checkpoint": {
      "description": "Exact replayed TNSR BlobId.",
      "$ref": "#/$defs/BlobId"
    },
    "checkpoint_bytes": {
      "description": "Exact replayed TNSR length.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "completed_updates": {
      "description": "Complete declared update cursor.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "journal": {
      "description": "Complete gradient journal BlobId, including its trailer checksum.",
      "$ref": "#/$defs/BlobId"
    },
    "journal_bytes": {
      "description": "Exact complete journal bytes.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "plan": {
      "description": "Exact frozen native request identity.",
      "$ref": "#/$defs/NativeRefinementPlanId"
    }
  },
  "additionalProperties": false,
  "required": [
    "plan",
    "journal",
    "journal_bytes",
    "checkpoint",
    "checkpoint_bytes",
    "completed_updates"
  ],
  "$defs": {
    "BlobId": {
      "description": "Content identity for stored tensor or asset bytes.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "NativeRefinementPlanId": {
      "description": "Native recovery request identity in its own versioned domain, not a legacy PV recipe hash.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    }
  }
}
