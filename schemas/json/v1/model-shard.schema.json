{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelShard",
  "description": "Content-pinned shard declaration. Shard loading is a separate capability.",
  "type": "object",
  "properties": {
    "name": {
      "description": "Safe sibling-file basename.",
      "type": "string"
    },
    "package": {
      "description": "Exact-byte package identity required for this shard.",
      "$ref": "#/$defs/PackageId"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "package"
  ],
  "$defs": {
    "PackageId": {
      "description": "Content identity for a Tritium package.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    }
  }
}
