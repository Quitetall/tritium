{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TensorSemanticMeta",
  "description": "Codec/transport-independent candidate tensor metadata hashed before data.\n\nThis describes the hash preimage, not a caller-supplied qualification claim.",
  "oneOf": [
    {
      "description": "Exact raw stored floating-point payload interpretation.",
      "type": "object",
      "properties": {
        "Dense": {
          "type": "object",
          "properties": {
            "precision": {
              "description": "Stored precision; precision conversion is not identity equivalence.",
              "$ref": "#/$defs/ScalePrecision"
            },
            "shape": {
              "description": "Logical row-major dimensions, excluding tensor name and package offset.",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "precision"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Dense"
      ]
    },
    {
      "description": "Logical trits and exact stored scale bits, independent of physical codec.",
      "type": "object",
      "properties": {
        "Additive": {
          "type": "object",
          "properties": {
            "basis": {
              "description": "Input-axis basis, including block and deterministic sign identity.",
              "$ref": "#/$defs/Basis"
            },
            "cols": {
              "description": "Logical matrix columns.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "group": {
              "description": "Logical scale group width.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "law": {
              "description": "Scale anchor, relation and exact stored precision.",
              "$ref": "#/$defs/ScaleLaw"
            },
            "planes": {
              "description": "Actual plane allocation; unused maximum capacity is not content.",
              "$ref": "#/$defs/PlaneCounts"
            },
            "rows": {
              "description": "Logical matrix rows.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "tile": {
              "description": "Logical coefficient tile width.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "rows",
            "cols",
            "tile",
            "group",
            "planes",
            "law",
            "basis"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Additive"
      ]
    }
  ],
  "$defs": {
    "Basis": {
      "description": "Input-axis transform associated with an additive tensor.",
      "oneOf": [
        {
          "description": "No transform.",
          "type": "string",
          "const": "Identity"
        },
        {
          "description": "Normalized, self-inverse Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "Hadamard": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Hadamard"
          ]
        },
        {
          "description": "Deterministic signed Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "SignedRht": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "domain": {
                  "description": "Stable domain identifier for sign derivation.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "seed": {
                  "description": "Seed used to derive signs.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block",
                "seed",
                "domain"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SignedRht"
          ]
        }
      ]
    },
    "PlaneCounts": {
      "description": "Actual plane allocation, including future pruned per-tile payloads.",
      "oneOf": [
        {
          "description": "All tiles have this nonzero plane count, equal to layout maximum.",
          "type": "object",
          "properties": {
            "Uniform": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Uniform"
          ]
        },
        {
          "description": "Row-major counts for every 256-coefficient tile; zero prunes a tile.",
          "type": "object",
          "properties": {
            "PerTile": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "PerTile"
          ]
        }
      ]
    },
    "PlaneRelation": {
      "description": "Relationship between scales of successive additive planes.",
      "oneOf": [
        {
          "description": "Every plane has an independently fitted scale.",
          "type": "string",
          "const": "Free"
        },
        {
          "description": "Plane `p` has scale `s0 * (num / den)^p`.",
          "type": "object",
          "properties": {
            "Tied": {
              "type": "object",
              "properties": {
                "den": {
                  "description": "Denominator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "num": {
                  "description": "Numerator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "num",
                "den"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Tied"
          ]
        }
      ]
    },
    "ScaleAnchor": {
      "description": "Grouping axis to which an additive scale is anchored.",
      "oneOf": [
        {
          "description": "One scale per declared group.",
          "type": "string",
          "const": "Group"
        },
        {
          "description": "One scale per matrix row.",
          "type": "string",
          "const": "Row"
        },
        {
          "description": "One scale for the complete tensor.",
          "type": "string",
          "const": "Tensor"
        },
        {
          "description": "One scale per output channel.",
          "type": "string",
          "const": "Channel"
        }
      ]
    },
    "ScaleLaw": {
      "description": "Scale law represented as orthogonal anchor, relation, and storage precision.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Scale grouping axis.",
          "$ref": "#/$defs/ScaleAnchor"
        },
        "precision": {
          "description": "Scale storage precision.",
          "$ref": "#/$defs/ScalePrecision"
        },
        "relation": {
          "description": "Cross-plane scale relationship.",
          "$ref": "#/$defs/PlaneRelation"
        }
      },
      "additionalProperties": false,
      "required": [
        "anchor",
        "relation",
        "precision"
      ]
    },
    "ScalePrecision": {
      "description": "Precision used to store additive plane scales.",
      "oneOf": [
        {
          "description": "IEEE binary16.",
          "type": "string",
          "const": "F16"
        },
        {
          "description": "Brain floating-point 16-bit.",
          "type": "string",
          "const": "Bf16"
        },
        {
          "description": "IEEE binary32.",
          "type": "string",
          "const": "F32"
        }
      ]
    }
  }
}
