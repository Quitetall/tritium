{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantizationCompleted",
  "description": "Successful complete fit-stage observation; publication/release is separate.",
  "type": "object",
  "properties": {
    "assets": {
      "description": "Actual complete original asset-byte bindings.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedAssetDigest"
      }
    },
    "levels": {
      "description": "Actual complete per-level encoded output bindings, without circular roots.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/QuantOutputLevel"
      }
    },
    "sources": {
      "description": "Actual complete original tensor bindings.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/QuantSourceBinding"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "sources",
    "assets",
    "levels"
  ],
  "$defs": {
    "AdditiveLayout": {
      "description": "Semantic layout parameters for an additive tensor.",
      "type": "object",
      "properties": {
        "allocation": {
          "description": "Plane count allocation mode.",
          "$ref": "#/$defs/PlaneAllocation"
        },
        "basis": {
          "description": "Input-axis basis.",
          "$ref": "#/$defs/Basis"
        },
        "codec": {
          "description": "Per-plane codec.",
          "$ref": "#/$defs/PlaneCodec"
        },
        "cols": {
          "description": "Number of coefficients per row.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "group": {
          "description": "Scale group width.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "law": {
          "description": "Scale law.",
          "$ref": "#/$defs/ScaleLaw"
        },
        "max_planes": {
          "description": "Maximum plane count represented by this tensor.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rows": {
          "description": "Number of matrix rows.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tile": {
          "description": "Canonical tile width. Currently fixed at [`ADDITIVE_TILE_SIZE`].",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "transport": {
          "description": "Outer entropy transport.",
          "$ref": "#/$defs/Transport"
        }
      },
      "additionalProperties": false,
      "required": [
        "rows",
        "cols",
        "tile",
        "group",
        "max_planes",
        "allocation",
        "codec",
        "law",
        "basis",
        "transport"
      ]
    },
    "Basis": {
      "description": "Input-axis transform associated with an additive tensor.",
      "oneOf": [
        {
          "description": "No transform.",
          "type": "string",
          "const": "Identity"
        },
        {
          "description": "Normalized, self-inverse Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "Hadamard": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Hadamard"
          ]
        },
        {
          "description": "Deterministic signed Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "SignedRht": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "domain": {
                  "description": "Stable domain identifier for sign derivation.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "seed": {
                  "description": "Seed used to derive signs.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block",
                "seed",
                "domain"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SignedRht"
          ]
        }
      ]
    },
    "BlobId": {
      "description": "Content identity for stored tensor or asset bytes.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "BlobReference": {
      "description": "Stored-byte blob reference, local unless a declared shard is selected.",
      "type": "object",
      "properties": {
        "id": {
          "description": "BLAKE3 of the exact stored blob bytes, not a semantic tensor digest.",
          "$ref": "#/$defs/BlobId"
        },
        "shard": {
          "description": "Basename of a declared shard; `None` selects the root package.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "NamedAssetDigest": {
      "description": "Exact named asset-content binding in the candidate model preimage.",
      "type": "object",
      "properties": {
        "content": {
          "description": "Exact stored asset-content digest, not a shard/package identity.",
          "$ref": "#/$defs/BlobId"
        },
        "name": {
          "description": "Asset basename; names affect model semantics.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "content"
      ]
    },
    "PlaneAllocation": {
      "description": "Uniform or per-tile plane-count allocation policy.",
      "oneOf": [
        {
          "description": "Every tile uses the tensor's maximum plane count.",
          "type": "string",
          "const": "Uniform"
        },
        {
          "description": "Each tile records its own plane count.",
          "type": "string",
          "const": "PerTile"
        }
      ]
    },
    "PlaneCodec": {
      "description": "Compact code used for each additive ternary plane.",
      "oneOf": [
        {
          "description": "Two-bit ternary packing.",
          "type": "string",
          "const": "D2"
        },
        {
          "description": "Base-3 packing of five ternary coefficients per byte.",
          "type": "string",
          "const": "B3"
        },
        {
          "description": "Structured sparse 3-of-4 encoding.",
          "type": "string",
          "const": "S34"
        }
      ]
    },
    "PlaneCounts": {
      "description": "Actual plane allocation, including future pruned per-tile payloads.",
      "oneOf": [
        {
          "description": "All tiles have this nonzero plane count, equal to layout maximum.",
          "type": "object",
          "properties": {
            "Uniform": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Uniform"
          ]
        },
        {
          "description": "Row-major counts for every 256-coefficient tile; zero prunes a tile.",
          "type": "object",
          "properties": {
            "PerTile": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "PerTile"
          ]
        }
      ]
    },
    "PlaneRelation": {
      "description": "Relationship between scales of successive additive planes.",
      "oneOf": [
        {
          "description": "Every plane has an independently fitted scale.",
          "type": "string",
          "const": "Free"
        },
        {
          "description": "Plane `p` has scale `s0 * (num / den)^p`.",
          "type": "object",
          "properties": {
            "Tied": {
              "type": "object",
              "properties": {
                "den": {
                  "description": "Denominator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "num": {
                  "description": "Numerator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "num",
                "den"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Tied"
          ]
        }
      ]
    },
    "QuantOutputLevel": {
      "description": "Complete output bindings before provenance is added to the package manifest.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Global level label.",
          "type": "string"
        },
        "tensors": {
          "description": "Complete sorted tensor inventory with actual stored blob identities.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TensorMeta"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "tensors"
      ]
    },
    "QuantSourceBinding": {
      "description": "Actual original raw tensor-byte binding computed by the engine itself.",
      "type": "object",
      "properties": {
        "content": {
          "description": "BLAKE3 of exact original raw bytes; not original container/HF identity.",
          "$ref": "#/$defs/BlobId"
        },
        "source": {
          "description": "Original interpretation, not fitted layout.",
          "$ref": "#/$defs/QuantSourceTensor"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "content"
      ]
    },
    "QuantSourceTensor": {
      "description": "Original tensor interpretation, never an adapter-supplied content hash.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Exact logical tensor name.",
          "type": "string"
        },
        "precision": {
          "description": "Original stored float precision, before widening or fitting.",
          "$ref": "#/$defs/ScalePrecision"
        },
        "shape": {
          "description": "Positive row-major dimensions in the original source.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "shape",
        "precision"
      ]
    },
    "ScaleAnchor": {
      "description": "Grouping axis to which an additive scale is anchored.",
      "oneOf": [
        {
          "description": "One scale per declared group.",
          "type": "string",
          "const": "Group"
        },
        {
          "description": "One scale per matrix row.",
          "type": "string",
          "const": "Row"
        },
        {
          "description": "One scale for the complete tensor.",
          "type": "string",
          "const": "Tensor"
        },
        {
          "description": "One scale per output channel.",
          "type": "string",
          "const": "Channel"
        }
      ]
    },
    "ScaleLaw": {
      "description": "Scale law represented as orthogonal anchor, relation, and storage precision.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Scale grouping axis.",
          "$ref": "#/$defs/ScaleAnchor"
        },
        "precision": {
          "description": "Scale storage precision.",
          "$ref": "#/$defs/ScalePrecision"
        },
        "relation": {
          "description": "Cross-plane scale relationship.",
          "$ref": "#/$defs/PlaneRelation"
        }
      },
      "additionalProperties": false,
      "required": [
        "anchor",
        "relation",
        "precision"
      ]
    },
    "ScalePrecision": {
      "description": "Precision used to store additive plane scales.",
      "oneOf": [
        {
          "description": "IEEE binary16.",
          "type": "string",
          "const": "F16"
        },
        {
          "description": "Brain floating-point 16-bit.",
          "type": "string",
          "const": "Bf16"
        },
        {
          "description": "IEEE binary32.",
          "type": "string",
          "const": "F32"
        }
      ]
    },
    "TensorMeta": {
      "description": "Named tensor binding in one complete quality/size level.",
      "type": "object",
      "properties": {
        "blob": {
          "description": "Exact stored bytes and their package location.",
          "$ref": "#/$defs/BlobReference"
        },
        "name": {
          "description": "Logical tensor name, independent of any filesystem path.",
          "type": "string"
        },
        "storage": {
          "description": "Metadata required to interpret those bytes.",
          "$ref": "#/$defs/TensorStorage"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "blob",
        "storage"
      ]
    },
    "TensorStorage": {
      "description": "Payload interpretation for one named tensor, not backend admission.",
      "oneOf": [
        {
          "description": "Raw little-endian floating-point elements; no hidden tensor header.",
          "type": "object",
          "properties": {
            "Dense": {
              "type": "object",
              "properties": {
                "precision": {
                  "description": "Uses the existing floating-point storage vocabulary.",
                  "$ref": "#/$defs/ScalePrecision"
                },
                "shape": {
                  "description": "Nonempty positive dimensions in logical row-major order.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "shape",
                "precision"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Dense"
          ]
        },
        {
          "description": "Canonical packed planes/scales interpreted through the shared layout.",
          "type": "object",
          "properties": {
            "Additive": {
              "type": "object",
              "properties": {
                "layout": {
                  "description": "Geometry, law, basis, codec and outer transport.",
                  "$ref": "#/$defs/AdditiveLayout"
                },
                "planes": {
                  "description": "Actual plane counts; serialization does not imply execution support.",
                  "$ref": "#/$defs/PlaneCounts"
                }
              },
              "additionalProperties": false,
              "required": [
                "layout",
                "planes"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Additive"
          ]
        }
      ]
    },
    "Transport": {
      "description": "Optional entropy transport applied outside the tensor's plane codec.",
      "oneOf": [
        {
          "description": "Store codec bytes directly.",
          "type": "string",
          "const": "Raw"
        },
        {
          "description": "Joint Huffman coding with the specified block width.",
          "type": "object",
          "properties": {
            "JointHuffman": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Number of symbols grouped into one entropy-coding block.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "JointHuffman"
          ]
        }
      ]
    }
  }
}
