{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelManifest",
  "description": "Canonical semantic metadata for a packaged model.",
  "type": "object",
  "properties": {
    "architecture": {
      "description": "Architecture identifier used by the model loader.",
      "type": "string"
    },
    "assets": {
      "description": "Named non-weight assets such as config, tokenizer, and chat template.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/BlobId"
      }
    },
    "legacy_ids": {
      "description": "Legacy identities preserved by migration for receipt resolution.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "levels": {
      "description": "Direct-fit or imported quality levels available in this package.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Level"
      }
    },
    "schema": {
      "description": "Version of the schema used to interpret this manifest.",
      "$ref": "#/$defs/SchemaId"
    },
    "tensors": {
      "description": "Shared tensor semantics indexed by canonical tensor name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TensorMeta"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "architecture",
    "tensors",
    "levels",
    "assets",
    "legacy_ids"
  ],
  "$defs": {
    "AdditiveLayout": {
      "description": "Semantic layout parameters for an additive tensor.",
      "type": "object",
      "properties": {
        "allocation": {
          "description": "Plane count allocation mode.",
          "$ref": "#/$defs/PlaneAllocation"
        },
        "basis": {
          "description": "Input-axis basis.",
          "$ref": "#/$defs/Basis"
        },
        "codec": {
          "description": "Per-plane codec.",
          "$ref": "#/$defs/PlaneCodec"
        },
        "cols": {
          "description": "Number of coefficients per row.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "group": {
          "description": "Scale group width.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "law": {
          "description": "Scale law.",
          "$ref": "#/$defs/ScaleLaw"
        },
        "max_planes": {
          "description": "Maximum plane count represented by this tensor.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rows": {
          "description": "Number of matrix rows.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tile": {
          "description": "Canonical tile width. Currently fixed at [`ADDITIVE_TILE_SIZE`].",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "transport": {
          "description": "Outer entropy transport.",
          "$ref": "#/$defs/Transport"
        }
      },
      "additionalProperties": false,
      "required": [
        "rows",
        "cols",
        "tile",
        "group",
        "max_planes",
        "allocation",
        "codec",
        "law",
        "basis",
        "transport"
      ]
    },
    "Basis": {
      "description": "Input-axis transform associated with an additive tensor.",
      "oneOf": [
        {
          "description": "No transform.",
          "type": "string",
          "const": "Identity"
        },
        {
          "description": "Normalized, self-inverse Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "Hadamard": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Hadamard"
          ]
        },
        {
          "description": "Deterministic signed Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "SignedRht": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "domain": {
                  "description": "Stable domain identifier for sign derivation.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "seed": {
                  "description": "Seed used to derive signs.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "block",
                "seed",
                "domain"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SignedRht"
          ]
        }
      ]
    },
    "BlobId": {
      "description": "Content identity for stored tensor or asset bytes.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "DenseDType": {
      "description": "Dense element type available for preserved master or auxiliary tensors.",
      "oneOf": [
        {
          "description": "IEEE binary16.",
          "type": "string",
          "const": "F16"
        },
        {
          "description": "Brain floating-point 16-bit.",
          "type": "string",
          "const": "Bf16"
        },
        {
          "description": "IEEE binary32.",
          "type": "string",
          "const": "F32"
        }
      ]
    },
    "Level": {
      "description": "A named model level mapping tensor names to the blobs used at that level.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Stable, model-local level name.",
          "type": "string"
        },
        "provenance": {
          "description": "How this level was produced.",
          "$ref": "#/$defs/LevelProvenance"
        },
        "tensors": {
          "description": "Tensor-name to content-addressed blob mapping.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BlobId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "provenance",
        "tensors"
      ]
    },
    "LevelProvenance": {
      "description": "Provenance class for one directly usable model quality level.",
      "oneOf": [
        {
          "description": "Fitted directly from the source weights with the referenced evidence run.",
          "type": "object",
          "properties": {
            "Direct": {
              "type": "object",
              "properties": {
                "evidence": {
                  "description": "Stable evidence run-root digest identifying the fit.",
                  "type": "string"
                }
              },
              "required": [
                "evidence"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Direct"
          ]
        },
        {
          "description": "Imported as a prefix view of another level; not a direct fit.",
          "type": "object",
          "properties": {
            "ImportedPrefixOf": {
              "type": "object",
              "properties": {
                "level": {
                  "description": "Name of the source level whose stored planes form this prefix.",
                  "type": "string"
                }
              },
              "required": [
                "level"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ImportedPrefixOf"
          ]
        },
        {
          "description": "Imported without proof that it is a direct fit or exact prefix.",
          "type": "string",
          "const": "Imported"
        }
      ]
    },
    "PlaneAllocation": {
      "description": "Uniform or per-tile plane-count allocation policy.",
      "oneOf": [
        {
          "description": "Every tile uses the tensor's maximum plane count.",
          "type": "string",
          "const": "Uniform"
        },
        {
          "description": "Each tile records its own plane count.",
          "type": "string",
          "const": "PerTile"
        }
      ]
    },
    "PlaneCodec": {
      "description": "Compact code used for each additive ternary plane.",
      "oneOf": [
        {
          "description": "Two-bit ternary packing.",
          "type": "string",
          "const": "D2"
        },
        {
          "description": "Three-bit ternary packing.",
          "type": "string",
          "const": "B3"
        },
        {
          "description": "Structured sparse 3-of-4 encoding.",
          "type": "string",
          "const": "S34"
        }
      ]
    },
    "PlaneRelation": {
      "description": "Relationship between scales of successive additive planes.",
      "oneOf": [
        {
          "description": "Every plane has an independently fitted scale.",
          "type": "string",
          "const": "Free"
        },
        {
          "description": "Plane `p` has scale `s0 * (num / den)^p`.",
          "type": "object",
          "properties": {
            "Tied": {
              "type": "object",
              "properties": {
                "den": {
                  "description": "Denominator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "num": {
                  "description": "Numerator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "num",
                "den"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Tied"
          ]
        }
      ]
    },
    "ScaleAnchor": {
      "description": "Grouping axis to which an additive scale is anchored.",
      "oneOf": [
        {
          "description": "One scale per declared group.",
          "type": "string",
          "const": "Group"
        },
        {
          "description": "One scale per matrix row.",
          "type": "string",
          "const": "Row"
        },
        {
          "description": "One scale for the complete tensor.",
          "type": "string",
          "const": "Tensor"
        },
        {
          "description": "One scale per output channel.",
          "type": "string",
          "const": "Channel"
        }
      ]
    },
    "ScaleLaw": {
      "description": "Scale law represented as orthogonal anchor, relation, and storage precision.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Scale grouping axis.",
          "$ref": "#/$defs/ScaleAnchor"
        },
        "precision": {
          "description": "Scale storage precision.",
          "$ref": "#/$defs/ScalePrecision"
        },
        "relation": {
          "description": "Cross-plane scale relationship.",
          "$ref": "#/$defs/PlaneRelation"
        }
      },
      "additionalProperties": false,
      "required": [
        "anchor",
        "relation",
        "precision"
      ]
    },
    "ScalePrecision": {
      "description": "Precision used to store additive plane scales.",
      "oneOf": [
        {
          "description": "IEEE binary16.",
          "type": "string",
          "const": "F16"
        },
        {
          "description": "Brain floating-point 16-bit.",
          "type": "string",
          "const": "Bf16"
        },
        {
          "description": "IEEE binary32.",
          "type": "string",
          "const": "F32"
        }
      ]
    },
    "SchemaId": {
      "description": "Stable identifier for a schema family and its version.",
      "type": "object",
      "properties": {
        "major": {
          "description": "Major version; incompatible schemas require a new major version.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minor": {
          "description": "Minor version; additive compatible schema evolution increments this.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "SemanticTensorDigest": {
      "description": "Identity for a tensor's semantic values independent of its container.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "TensorMeta": {
      "description": "Physical representation and semantic identity recorded for one tensor.",
      "oneOf": [
        {
          "description": "Additive ternary tensor with a codec-independent semantic digest.",
          "type": "object",
          "properties": {
            "Additive": {
              "type": "object",
              "properties": {
                "blob": {
                  "description": "Content-addressed identity of the exact stored payload bytes.",
                  "$ref": "#/$defs/BlobId"
                },
                "layout": {
                  "description": "Tensor layout needed to decode the additive payload.",
                  "$ref": "#/$defs/AdditiveLayout"
                },
                "semantic_digest": {
                  "description": "Codec-independent identity of the tensor's semantic values.",
                  "$ref": "#/$defs/SemanticTensorDigest"
                }
              },
              "required": [
                "blob",
                "layout",
                "semantic_digest"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Additive"
          ]
        },
        {
          "description": "Dense tensor preserved as a master, adapter, or auxiliary model tensor.",
          "type": "object",
          "properties": {
            "Dense": {
              "type": "object",
              "properties": {
                "blob": {
                  "description": "Content-addressed identity of the exact stored payload bytes.",
                  "$ref": "#/$defs/BlobId"
                },
                "dtype": {
                  "description": "Element representation of the dense payload.",
                  "$ref": "#/$defs/DenseDType"
                },
                "shape": {
                  "description": "Logical tensor shape in row-major axis order.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "blob",
                "dtype",
                "shape"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Dense"
          ]
        }
      ]
    },
    "Transport": {
      "description": "Optional entropy transport applied outside the tensor's plane codec.",
      "oneOf": [
        {
          "description": "Store codec bytes directly.",
          "type": "string",
          "const": "Raw"
        },
        {
          "description": "Joint Huffman coding with the specified block width.",
          "type": "object",
          "properties": {
            "JointHuffman": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Number of symbols grouped into one entropy-coding block.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "JointHuffman"
          ]
        }
      ]
    }
  }
}
