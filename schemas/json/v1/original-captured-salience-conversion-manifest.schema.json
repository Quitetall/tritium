{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OriginalCapturedSalienceConversionManifest",
  "description": "Distinct mandatory A-salience plus B-training capture ancestry through C.\nStrict structure does not establish either numerical execution or qualification.",
  "type": "object",
  "properties": {
    "lineage": {
      "description": "Unchanged complete B-captured A->B->C vocabulary.",
      "$ref": "#/$defs/CapturedSalienceConversionManifest"
    },
    "original_capture": {
      "description": "Mandatory distinct original-A forward-only capture reference.",
      "$ref": "#/$defs/EvidenceReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "lineage",
    "original_capture"
  ],
  "$defs": {
    "AdditiveLayout": {
      "description": "Semantic layout parameters for an additive tensor.",
      "type": "object",
      "properties": {
        "allocation": {
          "description": "Plane count allocation mode.",
          "$ref": "#/$defs/PlaneAllocation"
        },
        "basis": {
          "description": "Input-axis basis.",
          "$ref": "#/$defs/Basis"
        },
        "codec": {
          "description": "Per-plane codec.",
          "$ref": "#/$defs/PlaneCodec"
        },
        "cols": {
          "description": "Number of coefficients per row.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "group": {
          "description": "Scale group width.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "law": {
          "description": "Scale law.",
          "$ref": "#/$defs/ScaleLaw"
        },
        "max_planes": {
          "description": "Maximum plane count represented by this tensor.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rows": {
          "description": "Number of matrix rows.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tile": {
          "description": "Canonical tile width. Currently fixed at [`ADDITIVE_TILE_SIZE`].",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "transport": {
          "description": "Outer entropy transport.",
          "$ref": "#/$defs/Transport"
        }
      },
      "additionalProperties": false,
      "required": [
        "rows",
        "cols",
        "tile",
        "group",
        "max_planes",
        "allocation",
        "codec",
        "law",
        "basis",
        "transport"
      ]
    },
    "Basis": {
      "description": "Input-axis transform associated with an additive tensor.",
      "oneOf": [
        {
          "description": "No transform.",
          "type": "string",
          "const": "Identity"
        },
        {
          "description": "Normalized, self-inverse Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "Hadamard": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Hadamard"
          ]
        },
        {
          "description": "Deterministic signed Walsh–Hadamard transform.",
          "type": "object",
          "properties": {
            "SignedRht": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Power-of-two transform block width.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "domain": {
                  "description": "Stable domain identifier for sign derivation.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "seed": {
                  "description": "Seed used to derive signs.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block",
                "seed",
                "domain"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SignedRht"
          ]
        }
      ]
    },
    "BlobId": {
      "description": "Content identity for stored tensor or asset bytes.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "BlobReference": {
      "description": "Stored-byte blob reference, local unless a declared shard is selected.",
      "type": "object",
      "properties": {
        "id": {
          "description": "BLAKE3 of the exact stored blob bytes, not a semantic tensor digest.",
          "$ref": "#/$defs/BlobId"
        },
        "shard": {
          "description": "Basename of a declared shard; `None` selects the root package.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "CapturedSalienceConversionManifest": {
      "description": "Separate mandatory captured profile; never silently unwrap into ordinary C.",
      "type": "object",
      "properties": {
        "capture": {
          "description": "Required complete standalone B capture run/span/root.",
          "$ref": "#/$defs/EvidenceReference"
        },
        "lineage": {
          "description": "Complete unchanged A->B->C source/output vocabulary.",
          "$ref": "#/$defs/SalienceConversionManifest"
        }
      },
      "additionalProperties": false,
      "required": [
        "lineage",
        "capture"
      ]
    },
    "EvidenceReference": {
      "description": "Evidence ancestry reference, not a self-approved quality/release verdict.",
      "type": "object",
      "properties": {
        "root": {
          "description": "BLAKE3 evidence root, not a blob id or package digest.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 32,
          "minItems": 32
        },
        "run": {
          "description": "Run identity of the evidence producer.",
          "type": "string"
        },
        "span": {
          "description": "Evidence span within that run.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run",
        "span",
        "root"
      ]
    },
    "LegacyModelIdentity": {
      "description": "Legacy model identity retained for later verified migration resolution.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Original namespaced identity; never reinterpreted as a new digest.",
          "type": "string"
        },
        "level": {
          "description": "Level holding the imported model.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "level"
      ]
    },
    "Level": {
      "description": "One complete model level; identical blob references may be shared across levels.",
      "type": "object",
      "properties": {
        "fit": {
          "description": "Declared production/import ancestry.",
          "$ref": "#/$defs/LevelFit"
        },
        "name": {
          "description": "Logical level name.",
          "type": "string"
        },
        "tensors": {
          "description": "Complete sorted tensor inventory; all levels have the same names/shapes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TensorMeta"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "fit",
        "tensors"
      ]
    },
    "LevelFit": {
      "description": "Recorded level provenance; external verification still governs claims.",
      "oneOf": [
        {
          "description": "Fitted directly from source weights; a nonempty evidence list is required.",
          "type": "object",
          "properties": {
            "Direct": {
              "type": "object",
              "properties": {
                "evidence": {
                  "description": "Ancestry references, not proof that the referenced logs are available/admitted.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/EvidenceReference"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "evidence"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Direct"
          ]
        },
        {
          "description": "Imported exact prefix of another level in this manifest.",
          "type": "object",
          "properties": {
            "ImportedPrefixOf": {
              "type": "object",
              "properties": {
                "level": {
                  "description": "Named parent level; cycles, self-links and absent parents are rejected.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "level"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ImportedPrefixOf"
          ]
        },
        {
          "description": "Imported weights without a direct-fit or exact-prefix claim.",
          "type": "string",
          "const": "Imported"
        }
      ]
    },
    "ManifestAsset": {
      "description": "Named model asset such as config, tokenizer or chat template.",
      "type": "object",
      "properties": {
        "blob": {
          "description": "Stored asset bytes; the directory must also declare the same asset name.",
          "$ref": "#/$defs/BlobReference"
        },
        "name": {
          "description": "Safe basename, not an extraction path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "blob"
      ]
    },
    "ModelManifest": {
      "description": "Typed `.trit` model metadata. Field profile is proposed, not release-admitted.\n\nValidation establishes structural consistency only: no architecture coverage,\ntokenizer validity, evidence availability, model quality or backend capability.",
      "type": "object",
      "properties": {
        "architecture": {
          "description": "Architecture identifier; execution admission belongs to the loader.",
          "type": "string"
        },
        "assets": {
          "description": "Sorted assets, including `config.json` and `tokenizer.json`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestAsset"
          }
        },
        "legacy_ids": {
          "description": "Sorted legacy-id map; verified migration must establish their authenticity.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegacyModelIdentity"
          }
        },
        "levels": {
          "description": "Sorted complete levels, not incremental patches or inferred prefixes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Level"
          }
        },
        "schema": {
          "description": "Model metadata version, independent of the outer package version.",
          "$ref": "#/$defs/SchemaId"
        },
        "shards": {
          "description": "Sorted shard declarations.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelShard"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "architecture",
        "assets",
        "levels",
        "shards",
        "legacy_ids"
      ]
    },
    "ModelShard": {
      "description": "Content-pinned shard declaration. Shard loading is a separate capability.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Safe sibling-file basename.",
          "type": "string"
        },
        "package": {
          "description": "Exact-byte package identity required for this shard.",
          "$ref": "#/$defs/PackageId"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "package"
      ]
    },
    "OriginalSourceId": {
      "description": "Candidate identity of original named tensor/asset content, not fitted content or provenance.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "PackageId": {
      "description": "Content identity for a Tritium package.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "PlaneAllocation": {
      "description": "Uniform or per-tile plane-count allocation policy.",
      "oneOf": [
        {
          "description": "Every tile uses the tensor's maximum plane count.",
          "type": "string",
          "const": "Uniform"
        },
        {
          "description": "Each tile records its own plane count.",
          "type": "string",
          "const": "PerTile"
        }
      ]
    },
    "PlaneCodec": {
      "description": "Compact code used for each additive ternary plane.",
      "oneOf": [
        {
          "description": "Two-bit ternary packing.",
          "type": "string",
          "const": "D2"
        },
        {
          "description": "Base-3 packing of five ternary coefficients per byte.",
          "type": "string",
          "const": "B3"
        },
        {
          "description": "Structured sparse 3-of-4 encoding.",
          "type": "string",
          "const": "S34"
        }
      ]
    },
    "PlaneCounts": {
      "description": "Actual plane allocation, including future pruned per-tile payloads.",
      "oneOf": [
        {
          "description": "All tiles have this nonzero plane count, equal to layout maximum.",
          "type": "object",
          "properties": {
            "Uniform": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Uniform"
          ]
        },
        {
          "description": "Row-major counts for every 256-coefficient tile; zero prunes a tile.",
          "type": "object",
          "properties": {
            "PerTile": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "PerTile"
          ]
        }
      ]
    },
    "PlaneRelation": {
      "description": "Relationship between scales of successive additive planes.",
      "oneOf": [
        {
          "description": "Every plane has an independently fitted scale.",
          "type": "string",
          "const": "Free"
        },
        {
          "description": "Plane `p` has scale `s0 * (num / den)^p`.",
          "type": "object",
          "properties": {
            "Tied": {
              "type": "object",
              "properties": {
                "den": {
                  "description": "Denominator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "num": {
                  "description": "Numerator of the positive scale ratio.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "num",
                "den"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Tied"
          ]
        }
      ]
    },
    "SalienceConversionManifest": {
      "description": "Required lineage wrapped around the unchanged inner fitted model manifest.",
      "type": "object",
      "properties": {
        "conversion": {
          "description": "Actual complete B->C conversion run/span/run-root.",
          "$ref": "#/$defs/EvidenceReference"
        },
        "derived_source": {
          "description": "Actual complete B consumed by fitting; may equal A for identity transforms.",
          "$ref": "#/$defs/OriginalSourceId"
        },
        "model": {
          "description": "Complete unchanged B->C model/output vocabulary.",
          "$ref": "#/$defs/ModelManifest"
        },
        "original_source": {
          "description": "Actual original complete dense A identity.",
          "$ref": "#/$defs/OriginalSourceId"
        },
        "schema": {
          "description": "The only admitted candidate carrier version is 1.0.",
          "$ref": "#/$defs/SchemaId"
        },
        "stage_package": {
          "description": "Actual immutable B stage physical identity, not only B's raw source identity.",
          "$ref": "#/$defs/PackageId"
        },
        "transform": {
          "description": "Actual complete mandatory transform run/span/root.",
          "$ref": "#/$defs/EvidenceReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "model",
        "stage_package",
        "original_source",
        "derived_source",
        "transform",
        "conversion"
      ]
    },
    "ScaleAnchor": {
      "description": "Grouping axis to which an additive scale is anchored.",
      "oneOf": [
        {
          "description": "One scale per declared group.",
          "type": "string",
          "const": "Group"
        },
        {
          "description": "One scale per matrix row.",
          "type": "string",
          "const": "Row"
        },
        {
          "description": "One scale for the complete tensor.",
          "type": "string",
          "const": "Tensor"
        },
        {
          "description": "One scale per output channel.",
          "type": "string",
          "const": "Channel"
        }
      ]
    },
    "ScaleLaw": {
      "description": "Scale law represented as orthogonal anchor, relation, and storage precision.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Scale grouping axis.",
          "$ref": "#/$defs/ScaleAnchor"
        },
        "precision": {
          "description": "Scale storage precision.",
          "$ref": "#/$defs/ScalePrecision"
        },
        "relation": {
          "description": "Cross-plane scale relationship.",
          "$ref": "#/$defs/PlaneRelation"
        }
      },
      "additionalProperties": false,
      "required": [
        "anchor",
        "relation",
        "precision"
      ]
    },
    "ScalePrecision": {
      "description": "Precision used to store additive plane scales.",
      "oneOf": [
        {
          "description": "IEEE binary16.",
          "type": "string",
          "const": "F16"
        },
        {
          "description": "Brain floating-point 16-bit.",
          "type": "string",
          "const": "Bf16"
        },
        {
          "description": "IEEE binary32.",
          "type": "string",
          "const": "F32"
        }
      ]
    },
    "SchemaId": {
      "description": "Stable identifier for a schema family and its version.",
      "type": "object",
      "properties": {
        "major": {
          "description": "Major version; incompatible schemas require a new major version.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minor": {
          "description": "Minor version; additive compatible schema evolution increments this.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "TensorMeta": {
      "description": "Named tensor binding in one complete quality/size level.",
      "type": "object",
      "properties": {
        "blob": {
          "description": "Exact stored bytes and their package location.",
          "$ref": "#/$defs/BlobReference"
        },
        "name": {
          "description": "Logical tensor name, independent of any filesystem path.",
          "type": "string"
        },
        "storage": {
          "description": "Metadata required to interpret those bytes.",
          "$ref": "#/$defs/TensorStorage"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "blob",
        "storage"
      ]
    },
    "TensorStorage": {
      "description": "Payload interpretation for one named tensor, not backend admission.",
      "oneOf": [
        {
          "description": "Raw little-endian floating-point elements; no hidden tensor header.",
          "type": "object",
          "properties": {
            "Dense": {
              "type": "object",
              "properties": {
                "precision": {
                  "description": "Uses the existing floating-point storage vocabulary.",
                  "$ref": "#/$defs/ScalePrecision"
                },
                "shape": {
                  "description": "Nonempty positive dimensions in logical row-major order.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "shape",
                "precision"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Dense"
          ]
        },
        {
          "description": "Canonical packed planes/scales interpreted through the shared layout.",
          "type": "object",
          "properties": {
            "Additive": {
              "type": "object",
              "properties": {
                "layout": {
                  "description": "Geometry, law, basis, codec and outer transport.",
                  "$ref": "#/$defs/AdditiveLayout"
                },
                "planes": {
                  "description": "Actual plane counts; serialization does not imply execution support.",
                  "$ref": "#/$defs/PlaneCounts"
                }
              },
              "additionalProperties": false,
              "required": [
                "layout",
                "planes"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Additive"
          ]
        }
      ]
    },
    "Transport": {
      "description": "Optional entropy transport applied outside the tensor's plane codec.",
      "oneOf": [
        {
          "description": "Store codec bytes directly.",
          "type": "string",
          "const": "Raw"
        },
        {
          "description": "Joint Huffman coding with the specified block width.",
          "type": "object",
          "properties": {
            "JointHuffman": {
              "type": "object",
              "properties": {
                "block": {
                  "description": "Number of symbols grouped into one entropy-coding block.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "block"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "JointHuffman"
          ]
        }
      ]
    }
  }
}
