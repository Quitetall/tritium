  "objective": blob_id,
  "source": original_source_id,
  "tensor": quant_source_tensor,
  "tokenizer": blob_id
}

owner_score_cache_id = [32*32 0..255]

owner_score_cache_limits = {
  "max_context_bytes": uint,
  "max_context_tensors": uint,
  "max_invocations": uint,
  "max_payload_bytes": uint,
  "max_samples": uint
