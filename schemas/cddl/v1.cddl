  "limits": owner_score_metric_limits,
  "max_row_bindings": uint,
  "windows": [* weighted_owner_cache]
}

owner_score_levels_fitted = {
  "outputs": [* direct_fit_output],
  "plan": owner_score_fit_plan,
  "rayon_threads": 0..4294967295,
  "rows": [* owner_row_metric_binding],
  "rows_content": owner_metric_rows_id,
