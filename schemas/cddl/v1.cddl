  "max_payload_bytes": uint,
  "max_reduction_entries": uint,
  "max_row_bytes": uint,
  "max_windows": uint
}

owner_score_role = "Matmul" / "Gather"

owner_score_window_meta = {
  "context": [* owner_context_meta],
  "invocations": [* owner_invocation_meta]
}

package_id = [32*32 0..255]

plane_allocation = "Uniform" / "PerTile"

plane_codec = "D2" / "B3" / "S34"

plane_counts = {
  "Uniform": 0..255
} / {
  "PerTile": [* 0..255]
}

plane_relation = "Free" / {
  "Tied": {
    "den": 0..4294967295,
    "num": 0..4294967295
  }
}

quant_action = "KeepDense" / {
  "Fit": {
    "metric": direct_fit_metric,
    "plan": direct_fit_plan
  }
}

quant_limits = {
  "max_asset_bytes": uint,
  "max_package_bytes": uint,
