}

owner_quantization_completed = {
  "original_source": original_source_id,
  "output": quantization_completed
}

owner_quantization_started = {
  "plan": owner_quant_plan
}

owner_row_metric_binding = {
  "content": owner_row_metric_id,
  "row": uint
}

owner_row_metric_id = [32*32 0..255]

owner_score_cache_binding = {
  "cache": owner_score_cache_id,
  "content": owner_score_cache_content,
  "context_bytes": uint,
  "payload_bytes": uint,
  "samples": uint
}

owner_score_cache_content = {
