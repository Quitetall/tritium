# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SOURCE_DATE_EPOCH
# Linux/amd64 release inputs. Refreshing either digest is a reviewed supply-chain change.
FROM docker.io/library/rust:1.89.0-bookworm@sha256:c9ac3fa8945b61dede1e4500d25028aa8fd8a8fe46365fcf9c0422f8d999b9b0 AS build
ARG SOURCE_REVISION
ARG SOURCE_CREATED
ARG SOURCE_DATE_EPOCH
ARG CARGO_NET_OFFLINE=false
ENV CARGO_NET_OFFLINE=${CARGO_NET_OFFLINE} \
    TRITIUM_SOURCE_ID=source-git:${SOURCE_REVISION}
WORKDIR /src
COPY . .
RUN test "${#SOURCE_REVISION}" -eq 40 \
    && printf '%s' "${SOURCE_REVISION}" | grep -Eq '^[0-9a-f]{40}$' \
    && test -n "${SOURCE_CREATED}"
RUN cargo build --frozen --profile dist -p tritium-serve --features serve --bin tritium-serve

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:471dbca9cad607b9a32c10e9c31fb09ffaeb2d460e0afbff86c27abbc80b1b98
ARG SOURCE_REVISION
ARG SOURCE_CREATED
LABEL org.opencontainers.image.title="Tritium Serve CPU" \
      org.opencontainers.image.description="Verified ternary-model inference server (CPU)" \
      org.opencontainers.image.source="https://github.com/Quitetall/tritium" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.created="${SOURCE_CREATED}" \
      org.opencontainers.image.version="1.1.0-rc.1" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.tritium.backend="cpu" \
      io.tritium.artifact.schema="3" \
      io.tritium.startup-receipt.schema="1"
COPY --from=build --chown=65532:65532 /src/target/dist/tritium-serve /usr/local/bin/tritium-serve
COPY --chown=65532:65532 LICENSE NOTICE /usr/share/licenses/tritium/
COPY --chown=65532:65532 deploy/oci/models /models
USER 65532:65532
WORKDIR /
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tritium-serve"]
