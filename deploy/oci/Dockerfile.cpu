# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SOURCE_DATE_EPOCH
# Linux/amd64 release inputs. Refreshing either digest is a reviewed supply-chain change.
# Toolchain: this image deliberately stays on the PUBLISHED MSRV FLOOR (rust-version in
# Cargo.toml), not on the build toolchain in rust-toolchain.toml. CI builds with a newer
# pinned Rust; the shipped container building at the floor is a standing proof that the
# floor actually works for a real artifact. Moving it means resolving a new base-image
# digest and re-qualifying the image, which is its own change.
FROM docker.io/library/rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS build
ARG SOURCE_REVISION
ARG SOURCE_CREATED
ARG SOURCE_DATE_EPOCH
ARG CARGO_NET_OFFLINE=false
ENV CARGO_NET_OFFLINE=${CARGO_NET_OFFLINE} \
    RUSTUP_TOOLCHAIN=1.98.0 \
    TRITIUM_SOURCE_ID=source-git:${SOURCE_REVISION}
WORKDIR /src
COPY . .
RUN test "${#SOURCE_REVISION}" -eq 40 \
    && printf '%s' "${SOURCE_REVISION}" | grep -Eq '^[0-9a-f]{40}$' \
    && test -n "${SOURCE_CREATED}"
RUN cargo build --frozen --profile dist -p tritium-serve --features serve --bin tritium-serve

# The server binary does not link OpenSSL.  The no-SSL runtime removes an
# otherwise unused libssl attack surface and avoids inheriting OpenSSL CVEs.
FROM gcr.io/distroless/base-nossl-debian13:nonroot@sha256:5cab74e7f8a5e7c5f1c8a9e6268b1f352f053c36c656f493308340bcecbc636c
ARG SOURCE_REVISION
ARG SOURCE_CREATED
LABEL org.opencontainers.image.title="Tritium Serve CPU" \
      org.opencontainers.image.description="Verified ternary-model inference server (CPU)" \
      org.opencontainers.image.source="https://github.com/Quitetall/tritium" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.created="${SOURCE_CREATED}" \
      org.opencontainers.image.version="1.1.0-rc.2" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.tritium.backend="cpu" \
      io.tritium.artifact.schema="3" \
      io.tritium.startup-receipt.schema="1"
COPY --from=build --chown=65532:65532 /src/target/dist/tritium-serve /usr/local/bin/tritium-serve
# Rust's dynamically linked binary needs libgcc_s; base-nossl intentionally
# omits compiler runtimes while retaining glibc and the dynamic loader.
COPY --from=build /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /usr/lib/x86_64-linux-gnu/libgcc_s.so.1
COPY --chown=65532:65532 LICENSE NOTICE /usr/share/licenses/tritium/
COPY --chown=65532:65532 deploy/oci/models /models
USER 65532:65532
WORKDIR /
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tritium-serve"]
