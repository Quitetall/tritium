{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "backend", "artifact", "auth", "service", "requestLimits", "resources", "gpu", "podSecurityContext", "containerSecurityContext", "terminationGracePeriodSeconds", "revisionHistoryLimit", "probes", "nodeSelector", "affinity", "tolerations", "topologySpreadConstraints", "pdb", "networkPolicy", "serviceMonitor", "keda"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 64},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^\\s@]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}}
      }
    },
    "backend": {"enum": ["cpu", "cuda"]},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "serviceAccountName": {"type": "string", "maxLength": 253},
    "runtimeClassName": {"type": "string", "maxLength": 253},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePvc", "modelFile", "expectedSha256", "stagedSizeLimit", "verifierImage"],
      "properties": {
        "sourcePvc": {
          "type": "object", "additionalProperties": false, "required": ["claimName", "subPath"],
          "properties": {
            "claimName": {"type": "string", "minLength": 1, "maxLength": 253},
            "subPath": {"type": "string", "maxLength": 1024}
          }
        },
        "modelFile": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$"},
        "expectedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stagedSizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
        "verifierImage": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false, "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253},
        "key": {"type": "string", "minLength": 1, "maxLength": 253}
      }
    },
    "service": {
      "type": "object", "additionalProperties": false, "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "requestLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxNew", "maxMessages", "maxPromptBytes", "maxPromptTokens", "maxCompletionTokens", "maxTotalTokens", "rateLimitRpm", "rateLimitBurst"],
      "properties": {
        "maxNew": {"type": "integer", "minimum": 1, "maximum": 65536},
        "maxMessages": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maxPromptBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "maxPromptTokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maxCompletionTokens": {"type": "integer", "minimum": 1, "maximum": 65536},
        "maxTotalTokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "rateLimitRpm": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "rateLimitBurst": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number"]}},
        "limits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number"]}}
      }
    },
    "gpu": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "resourceName", "count"],
      "properties": {
        "enabled": {"type": "boolean"},
        "resourceName": {"type": "string", "pattern": "^[A-Za-z0-9.-]+/[A-Za-z0-9._-]+$"},
        "count": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "podSecurityContext": {
      "type": "object", "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "fsGroupChangePolicy", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "fsGroup": {"type": "integer", "minimum": 1},
        "fsGroupChangePolicy": {"enum": ["Always", "OnRootMismatch"]},
        "seccompProfile": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "RuntimeDefault"}}}
      }
    },
    "containerSecurityContext": {
      "type": "object", "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": {"const": false},
        "readOnlyRootFilesystem": {"const": true},
        "capabilities": {
          "type": "object", "additionalProperties": false, "required": ["drop"],
          "properties": {"drop": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "ALL"}}}
        }
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 10, "maximum": 3600},
    "revisionHistoryLimit": {"type": "integer", "minimum": 1, "maximum": 20},
    "probes": {
      "type": "object", "additionalProperties": false, "required": ["startup", "readiness", "liveness", "watchdog"],
      "properties": {
        "startup": {"$ref": "#/$defs/probe"},
        "readiness": {"$ref": "#/$defs/probe"},
        "liveness": {"$ref": "#/$defs/probe"},
        "watchdog": {"$ref": "#/$defs/probe"}
      }
    },
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},
    "topologySpreadConstraints": {"type": "array"},
    "pdb": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "minAvailable"],
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^[0-9]+%$"}]}}
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "ingressNamespaceSelector"],
      "properties": {"enabled": {"type": "boolean"}, "ingressNamespaceSelector": {"type": "object"}}
    },
    "serviceMonitor": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "interval", "labels", "ingressNamespaceSelector"],
      "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}, "labels": {"type": "object"}, "ingressNamespaceSelector": {"type": "object", "minProperties": 1}}
    },
    "keda": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "minReplicaCount", "maxReplicaCount", "pollingInterval", "cooldownPeriod", "stabilizationWindowSeconds", "prometheus"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicaCount": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxReplicaCount": {"type": "integer", "minimum": 1, "maximum": 256},
        "pollingInterval": {"type": "integer", "minimum": 5, "maximum": 3600},
        "cooldownPeriod": {"type": "integer", "minimum": 30, "maximum": 86400},
        "stabilizationWindowSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "prometheus": {
          "type": "object", "additionalProperties": false, "required": ["serverAddress", "threshold", "query"],
          "properties": {
            "serverAddress": {"type": "string", "pattern": "^https?://"},
            "threshold": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "query": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        }
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["failureThreshold", "periodSeconds", "timeoutSeconds"],
      "properties": {
        "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 120},
        "periodSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"backend": {"const": "cuda"}}}, "then": {"properties": {"gpu": {"properties": {"enabled": {"const": true}}}}}},
    {"if": {"properties": {"gpu": {"properties": {"enabled": {"const": true}}}}}, "then": {"properties": {"backend": {"const": "cuda"}}}}
  ]
}
