/target
**/*.rs.bk
# Cargo.lock is tracked — the workspace ships a binary (tritium-cli), so a locked
# dependency graph keeps builds reproducible.

# build artifacts from backends
*.ptx
*.cubin
*.o
*.so
*.dylib
*.dll

# autotune + JIT cache (mirrors ~/.cache/tritium at runtime)
/.tritium-cache

# mimocode executor scratch (node tooling + ephemeral plans; durable plans live in docs/)
/.mimocode

# python / maturin
*.whl
__pycache__/
.venv/

# editor / os
.DS_Store
*.swp

# cargo-fuzz generated
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/
crates/*/fuzz/coverage/
crates/*/fuzz/target/

# python test/build artifacts
.pytest_cache/
**/__pycache__/
*.pyc
/target/wheels/

# CycloneDX SBOMs (generated in CI, uploaded as an artifact)
*.cdx.json
