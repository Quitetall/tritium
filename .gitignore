/target
**/*.rs.bk
# Cargo.lock is tracked — the workspace ships a binary (tritium-cli), so a locked
# dependency graph keeps builds reproducible.

# build artifacts from backends
*.ptx
*.cubin
*.o
*.so
*.dylib
*.dll

# autotune + JIT cache (mirrors ~/.cache/tritium at runtime)
/.tritium-cache

# mimocode executor scratch (node tooling + ephemeral plans; durable plans live in docs/)
/.mimocode

# python / maturin
*.whl
__pycache__/
.venv/

# editor / os
.DS_Store
*.swp

# cargo-fuzz generated
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/
crates/*/fuzz/coverage/
crates/*/fuzz/target/

# python test/build artifacts
.pytest_cache/
**/__pycache__/
*.pyc
/target/wheels/

# CycloneDX SBOMs (generated in CI, uploaded as an artifact)
*.cdx.json

# Unpublished local release-candidate payloads. Source manifests and schemas live
# outside this directory; exact archives/evidence can be tens of gigabytes.
/release/v1.1/

# mdbook build output (the book source under docs/book/src is tracked; the
# rendered HTML + linkcheck cache are generated by `mdbook build`)
/docs/book/book/

# Session-local tool state and scratch outputs (never source)
.claude/
.codex/
graphify-out/
scratch_st/

# Research/ADR/plan docs live in the private tritium-research repo (docs/RESEARCH.md);
# working copies remain on disk for active sessions but are untracked.
# Research records are default-DENY here. The working front lives in the private
# tritium-research repo; a record appears in this repo only once its decision has
# shipped (docs/RESEARCH.md). Promotion is an explicit un-ignore of one file, which
# is the forcing function: you cannot publish a record by accident, and the .gitignore
# diff is the promotion audit trail.
docs/adr/*
!docs/adr/README.md
docs/plans/
docs/paper/
docs/research-*.md
docs/ROADMAP.md
docs/EXECUTOR.md
docs/OPTIMIZATION-LOG.md
docs/receipts-ws-*
docs/bastion-lamu-integration.md
docs/drafter-blut-handoff.md
packages/tritium-web/node_modules
