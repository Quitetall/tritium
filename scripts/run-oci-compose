#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || ( "$1" != cpu && "$1" != cuda ) ]]; then
  echo "usage: scripts/run-oci-compose cpu|cuda [docker compose arguments...]" >&2
  exit 2
fi
flavor="$1"
shift
image="${TRITIUM_IMAGE:-}"
[[ "$image" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]] || {
  echo "TRITIUM_IMAGE must be an exact name@sha256 digest" >&2
  exit 2
}
[[ -n "${TRITIUM_BUNDLE:-}" && -d "$TRITIUM_BUNDLE" && ! -L "$TRITIUM_BUNDLE" ]] || {
  echo "TRITIUM_BUNDLE must be an ordinary schema-v3 bundle directory" >&2
  exit 2
}
TRITIUM_BUNDLE="$(cd "$TRITIUM_BUNDLE" && pwd -P)"
for asset in tritium.json config.json tokenizer.json tokenizer_config.json preserved.safetensors; do
  [[ -f "$TRITIUM_BUNDLE/$asset" && ! -L "$TRITIUM_BUNDLE/$asset" ]] || {
    echo "TRITIUM_BUNDLE lacks ordinary required asset $asset" >&2
    exit 2
  }
done
TRITIUM_PROFILE="${TRITIUM_PROFILE:-compact-v1}"
[[ "$TRITIUM_PROFILE" == compact-v1 || "$TRITIUM_PROFILE" == near-lossless-v1 ]] || {
  echo "TRITIUM_PROFILE must be compact-v1 or near-lossless-v1" >&2
  exit 2
}
export TRITIUM_BUNDLE TRITIUM_PROFILE
[[ -n "${TRITIUM_AUTH_TOKEN:-}" ]] || {
  echo "TRITIUM_AUTH_TOKEN is required" >&2
  exit 2
}
if [[ $# -eq 0 ]]; then
  set -- up
fi
exec docker compose -f "deploy/oci/compose.${flavor}.yaml" "$@"
