{
  "name": "@tritium-ai/web",
  "version": "1.1.0-rc.1",
  "description": "Compiled ternary training sessions for WebGPU and WebAssembly",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qualification": {
      "types": "./dist/qualification.d.ts",
      "import": "./dist/qualification.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "generate:browser-vectors": "node scripts/generate-browser-vector-metadata.mjs",
    "generate:bindings": "node scripts/generate-operation-bindings.mjs",
    "generate:webgpu-kernels": "node scripts/generate-webgpu-kernels.mjs",
    "check:generated": "node scripts/generate-browser-vector-metadata.mjs --check && node scripts/generate-operation-bindings.mjs --check && node scripts/generate-webgpu-kernels.mjs --check",
    "typecheck": "npm run check:generated && npm run build:wasm && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run verify:pack",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "2.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "keywords": []
}
