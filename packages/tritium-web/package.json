{
  "name": "@tritium-ai/web",
  "version": "1.1.0-rc.0",
  "description": "Compiled ternary training sessions for WebGPU and WebAssembly",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "npm run build:wasm && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@noble/hashes": "2.2.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "keywords": []
}
